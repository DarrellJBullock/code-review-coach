{
  "name": "code-review-coach",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace packages/shared",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:worker": "npm run start:worker:dev --workspace apps/api",
    "build": "npm run build --workspace packages/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
