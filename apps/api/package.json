{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API + BullMQ worker for PR Review Coach.",
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only --exit-child src/main.ts",
    "start:worker:dev": "ts-node-dev --respawn --transpile-only --exit-child src/worker.main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@code-review-coach/shared": "*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.81.1",
    "express-session": "^1.19.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "24.13.3",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.3"
  }
}
