# Copy this file to .env and fill in real values.
# Never commit .env — it is already in .gitignore.

# GitHub OAuth App client ID. Create the OAuth App at
# GitHub Settings > Developer settings > OAuth Apps, then copy the client ID here.
GITHUB_CLIENT_ID=

# GitHub OAuth App client secret, generated alongside the client ID above.
# Treat as a secret — do not commit or share.
GITHUB_CLIENT_SECRET=

# Shared secret used to verify GitHub webhook payload signatures (set the same
# value when configuring the webhook on the GitHub App/OAuth App/repo settings).
GITHUB_WEBHOOK_SECRET=

# Anthropic API key used to call Claude for generating PR reviews.
# Obtain from the Anthropic Console (console.anthropic.com) under API Keys.
ANTHROPIC_API_KEY=

# Postgres connection string for Prisma. Matches the `postgres` service in
# docker-compose.yml (user/password/db: postgres/postgres/code_review_coach).
# Published on host port 5433 (not the default 5432) to avoid clashing with
# another project's Postgres on this machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/code_review_coach

# Redis connection string for BullMQ. Matches the `redis` service in
# docker-compose.yml. Published on host port 6380 (not the default 6379) to
# avoid clashing with another project's Redis on this machine.
REDIS_URL=redis://localhost:6380

# Secret used to sign/encrypt user session cookies. Use a long random string,
# e.g. generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Key used for AES-256-GCM encryption of stored GitHub access tokens. Must be
# a 32-byte value, e.g. generate with `openssl rand -hex 32`.
TOKEN_ENCRYPTION_KEY=

# URL of the NestJS API, used by the Next.js app (running on port 3000) to
# reach the API (running on port 4000).
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL of the Next.js web app, used by the NestJS API (apps/api) to know where
# to redirect the browser after a successful GitHub OAuth callback, and as the
# allowed CORS origin (with credentials/cookies) for cross-origin requests
# from the web app.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
